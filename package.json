{
  "name": "@zhuifengqug/dsh-tianshu-qunce",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test tests/core/*.test.mjs tests/host/*.test.mjs",
    "check:syntax": "node --check index.js && node --check typert.host.mjs && node --check typert.remote-client.mjs && node --check src/host/command.mjs && node --check src/host/context.mjs && node --check src/host/service.mjs && node --check src/host/session-adapter.mjs && node --check src/host/tool.mjs && node --check src/host/typert-spec.mjs"
  },
  "description": "天枢·群策：DSH 多会话协作 Host bundle",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./typert": "./typert.host.mjs",
    "./remote": "./typert.remote-client.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "typert.host.mjs",
    "typert.remote-client.mjs",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "locale/*.json",
    "icon.svg",
    "src/**/*.mjs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
